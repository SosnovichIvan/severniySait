{
  "name": "severniy-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'tsx watch server/start.ts' 'vite --host 127.0.0.1'",
    "start": "tsx server/start.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server contracts && tsx scripts/check-architecture.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e.ts",
    "build": "vite build",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "format": "prettier --write src server contracts tests scripts *.ts *.json *.js index.html .github/workflows/*.yml",
    "format:check": "prettier --check src server contracts tests scripts *.ts *.json *.js index.html .github/workflows/*.yml",
    "setup:local": "tsx scripts/create-env.ts",
    "verify:compile": "vite build --mode test --outDir .preview"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
